# KshetraAI Backend — Environment Configuration Example
# Copy this file to .env and update values for your environment
# NEVER commit the actual .env file

# ─── Application ───────────────────────────────────────────────
APP_NAME=KshetraAI
APP_ENV=development  # development | demo | production
DEBUG=true
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_TO_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ──────────────────────────────────────────────────
# SQLite (development default — zero external dependencies)
DATABASE_URL=sqlite:///./kshetraai.db
# PostgreSQL (production) — uncomment and configure:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kshetraai

# ─── Vector Database ───────────────────────────────────────────
CHROMA_DATA_DIR=./chroma_data
CHROMA_COLLECTION_NAME=kshetraai_knowledge

# ─── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
DELIVERABLES_DIR=./deliverables
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=pdf,docx,xlsx,pptx,png,jpg,jpeg,txt

# ─── Ollama (Local AI Runtime) ─────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300

# ─── Model Configuration ───────────────────────────────────────
# These control which models are used. Models must be pulled in Ollama first.
DEFAULT_REASONING_MODEL=qwen2.5:7b-instruct
DEFAULT_CODING_MODEL=qwen2.5-coder:7b-instruct
DEFAULT_VISION_MODEL=llava:7b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# ─── Agent ─────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=600

# ─── Sandbox ───────────────────────────────────────────────────
# RestrictedPython sandbox (MVP) — Docker for production
SANDBOX_TYPE=restricted_python  # restricted_python | docker
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=256

# ─── Sovereignty ───────────────────────────────────────────────
# These MUST remain true in production
EXTERNAL_AI_DISABLED=true
TELEMETRY_DISABLED=true

# ─── Security ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/kshetraai.log
